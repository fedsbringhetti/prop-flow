{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* `strict` è l'equivalente di «zero warning» del backend: senza, `any` entra
       per la porta di servizio ogni volta che un tipo è scomodo. Le quattro righe
       che seguono sono ciò che `strict` NON copre e che qui serve comunque —
       soprattutto `noUncheckedIndexedAccess`, senza cui `items[0]` è tipato come
       presente anche su un elenco vuoto, che è esattamente lo stato che ogni
       schermata di questa applicazione deve saper mostrare. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
