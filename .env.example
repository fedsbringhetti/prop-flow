# Copiare in .env (che è in .gitignore) e adattare.
# Il doppio underscore separa i livelli della configurazione.
#
# Questo file NON lo legge nessun processo: non c'è dotenvy nel workspace e
# docker-compose.yml dichiara le variabili inline. Lo carica chi avvia — `just`,
# che ha `set dotenv-load`, oppure la shell prima di lanciare un binario a mano:
#
#     set -a; source .env; set +a
#
# Vedi docs/08-decisioni.md#adr-023.

# Ruolo soggetto a Row Level Security: è la connessione del servizio HTTP.
PROPFLOW__DATABASE__APPLICATION_URL=postgres://propflow_app:app@localhost:5432/propflow
# Ruolo con BYPASSRLS: solo flussi pre-autenticazione (registrazione, login,
# rotazione dei refresh token) e i due cicli del worker — dispatcher dell'outbox e
# lettura automatica delle bollette.
PROPFLOW__DATABASE__PRIVILEGED_URL=postgres://propflow_worker:worker@localhost:5432/propflow
# Owner delle tabelle: usato solo dal binario delle migration.
PROPFLOW__DATABASE__MIGRATOR_URL=postgres://propflow_migrator:migrator@localhost:5432/propflow

# Il refresh token viaggia in un cookie httpOnly. In sviluppo si serve su
# http://localhost, e un browser non manda un cookie che dichiara `Secure` su HTTP:
# senza questa riga il refresh fallirebbe sempre e la sessione durerebbe i quindici
# minuti dell'access token. In produzione va lasciata al default, che è `true`.
PROPFLOW__SERVER__SECURE_COOKIES=false

# Generare con: ./ops/dev/generate-jwt-keys.sh
PROPFLOW__AUTH__PRIVATE_KEY_PATH=.secrets/jwt_ed25519.pem
PROPFLOW__AUTH__PUBLIC_KEY_PATH=.secrets/jwt_ed25519.pub.pem

# Storage oggetti dei documenti: MinIO in sviluppo (docker compose up -d minio
# minio-setup), S3 in produzione. Endpoint e bucket hanno un default nel file di
# configurazione; le credenziali no, e senza l'API non parte.
#
# Le legge anche il **worker**, che dalla fetta dell'OCR scarica da qui le scansioni
# da leggere: devono puntare allo stesso bucket dell'API.
PROPFLOW__STORAGE__ENDPOINT=http://localhost:9000
PROPFLOW__STORAGE__BUCKET=propflow-documents
PROPFLOW__STORAGE__ACCESS_KEY_ID=propflow
PROPFLOW__STORAGE__SECRET_ACCESS_KEY=propflow-dev-secret

# Telemetria: senza endpoint OTLP si esporta solo su stdout.
# PROPFLOW__TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
PROPFLOW__TELEMETRY__JSON_LOGS=false
